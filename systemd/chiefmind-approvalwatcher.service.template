[Unit]
Description=ChiefMind approved-action execution watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory="__VAULT_DIR__/scripts"
Environment="CHIEFMIND_ROOT=__VAULT_DIR__"
Environment=PYTHONUNBUFFERED=1
ExecStart="__VAULT_DIR__/scripts/.venv/bin/python" "__VAULT_DIR__/scripts/approval_watcher.py"
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput="append:__VAULT_DIR__/Logs/approvalwatcher.stdout.log"
StandardError="append:__VAULT_DIR__/Logs/approvalwatcher.stderr.log"

[Install]
WantedBy=default.target

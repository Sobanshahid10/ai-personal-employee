# Copy this file to scripts/.env and replace placeholders with real values.
# Never commit scripts/.env or any credential file.

# Base path. Leave blank to use the parent directory of scripts/config.py.
CHIEFMIND_ROOT=

# Optional path overrides. Relative paths are resolved from the process working
# directory, so absolute paths are recommended when overriding defaults.
SCRIPTS_DIR=
DASHBOARD_DIR=
DASHBOARD_STATIC_DIR=
DASHBOARD_TEMPLATES_DIR=
MCP_SERVERS_DIR=
GMAIL_MCP_SERVER_DIR=
DOCS_DIR=
LAUNCHD_DIR=
CREDENTIALS_DIR=
INBOX_DIR=
NEEDS_ACTION_DIR=
PLANS_DIR=
PENDING_APPROVAL_DIR=
APPROVED_DIR=
REJECTED_DIR=
DONE_DIR=
FAILED_DIR=
LOGS_DIR=

# Optional file overrides
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=
PROCESSED_IDS_FILE=
REASONING_LOOP_FILE=
KNOWLEDGE_BASE_FILE=
LOG_FILE=
EXECUTION_RECEIPTS_FILE=
LINKEDIN_POSTER_FILE=

# Groq (required before running the reasoning agent)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
REASONING_TOP_K=3
REASONING_MAX_TOKENS=1200
GROQ_RETRIES=3
GROQ_RETRY_DELAY=5

# Gmail watcher
GMAIL_QUERY=is:unread
GMAIL_USER_ID=me
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_POLL_INTERVAL=120
GMAIL_RETRIES=3
GMAIL_RETRY_DELAY=5
GMAIL_MAX_RESULTS=100

# Day 4 reasoning subprocess
REASONING_TRIGGER_TIMEOUT=300

# Day 5 execution watcher
APPROVAL_SETTLE_SECONDS=0.5
LINKEDIN_EXECUTION_TIMEOUT=300

# Dashboard. Generate a long, random approval token for real use.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
DASHBOARD_APPROVAL_TOKEN=replace_with_a_long_random_token
DASHBOARD_CORS_ORIGINS=*
DASHBOARD_MAX_FILE_BYTES=2000000
DASHBOARD_RECENT_ACTIVITY=20

# LinkedIn. Keep automation disabled until Day 7 is configured and tested.
AUTO_LINKEDIN_POSTS=false
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

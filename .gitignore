.DS_Store
.venv/
**/.venv/
*.env
**/*.env
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
credentials/
**/credentials/
!chiefmind/credentials/
chiefmind/credentials/*
!chiefmind/credentials/.gitkeep
credentials.json
**/credentials.json
token.json
**/token.json
processed_ids.json
**/processed_ids.json
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc

# Runtime workflow data can contain private emails, drafts, and audit records.
chiefmind/Inbox/*
chiefmind/Needs_Action/*
chiefmind/Plans/*
chiefmind/Pending_Approval/*
chiefmind/Approved/*
chiefmind/Rejected/*
chiefmind/Done/*
chiefmind/Failed/*
chiefmind/Logs/*
!chiefmind/Inbox/.gitkeep
!chiefmind/Needs_Action/.gitkeep
!chiefmind/Plans/.gitkeep
!chiefmind/Pending_Approval/.gitkeep
!chiefmind/Approved/.gitkeep
!chiefmind/Rejected/.gitkeep
!chiefmind/Done/.gitkeep
!chiefmind/Failed/.gitkeep
!chiefmind/Logs/.gitkeep

.DS_Store
.venv/
**/.venv/
*.env
**/*.env
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
credentials/
**/credentials/
!credentials/
credentials/*
!credentials/.gitkeep
credentials.json
**/credentials.json
token.json
**/token.json
processed_ids.json
**/processed_ids.json
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc

# Runtime workflow data can contain private emails, drafts, and audit records.
Inbox/*
Needs_Action/*
Plans/*
Pending_Approval/*
Approved/*
Rejected/*
Done/*
Failed/*
Logs/*
!Inbox/.gitkeep
!Needs_Action/.gitkeep
!Plans/.gitkeep
!Pending_Approval/.gitkeep
!Approved/.gitkeep
!Rejected/.gitkeep
!Done/.gitkeep
!Failed/.gitkeep
!Logs/.gitkeep

# Ignore private runtime remnants from the pre-refactor chiefmind/ layout.
chiefmind/credentials/*
chiefmind/Inbox/*
chiefmind/Needs_Action/*
chiefmind/Plans/*
chiefmind/Pending_Approval/*
chiefmind/Approved/*
chiefmind/Rejected/*
chiefmind/Done/*
chiefmind/Failed/*
chiefmind/Logs/*
